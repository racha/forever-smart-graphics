package-as: ForeverSmartGraphics

# The addon folder sits at the repo root; its move empties the package folder into ForeverSmartGraphics/.
move-folders:
  ForeverSmartGraphics/ForeverSmartGraphics: ForeverSmartGraphics

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - ForeverSmartGraphics/tests
  - .github
  - .gitignore
  - .pkgmeta
  - README.md
  - CONTRIBUTING.md
